              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"lead_id\":\"{{$json.lead_id}}\",\"channel\":\"telegram\",\"telegram_username\":\"{{$json.telegram_username}}\",\"message\":\"{{$json.client_message}}\",\"phone\":\"{{$json.phone}}\",\"name\":\"{{$json.name}}\"}",
        "options": {}
      },
