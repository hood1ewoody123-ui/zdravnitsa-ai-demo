{
  "name": "Zdravnitsa Intercept -> Telegram",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "intercept",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "Webhook_Intercept",
      "name": "Webhook Intercept",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        260,
        280
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "telegramMessage",
              "type": "string",
              "value": "🔔 Новая заявка — Здравница\\n\\n👤 {{$json.name}}\\n📞 {{$json.phone}}\\n💬 {{$json.situation}}\\n\\n🤖 Мила ответила:\\n{{$json.agent_reply}}\\n\\n🕐 {{$now}}"
            }
          ]
        },
        "options": {}
      },
      "id": "Set_Message",
      "name": "Set Telegram Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        500,
        280
      ]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "={{$json.telegramMessage}}",
        "additionalFields": {}
      },
      "id": "Telegram_Send",
      "name": "Telegram Send Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        760,
        280
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\": true, \"source\": \"n8n\", \"receivedAt\": \"{{$now}}\"}",
        "options": {}
      },
      "id": "Respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1020,
        280
      ]
    }
  ],
  "connections": {
    "Webhook Intercept": {
      "main": [
        [
          {
            "node": "Set Telegram Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Telegram Message": {
      "main": [
        [
          {
            "node": "Telegram Send Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram Send Message": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1"
}
