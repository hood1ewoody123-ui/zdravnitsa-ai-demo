{
  "name": "Zdravnitsa Intercept -> Manager + Client Delivery",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "intercept",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "Webhook_Intercept",
      "name": "Webhook Intercept",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [240, 340]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "manager_message",
              "type": "string",
              "value": "🔔 Новая заявка — Здравница\\n\\n🆔 Lead: {{$json.lead_id}}\\n👤 {{$json.name}}\\n📞 {{$json.phone}}\\n💬 {{$json.situation}}\\n\\n🤖 Мила ответила:\\n{{$json.agent_reply}}\\n\\n🚚 Автодоставка клиенту:\\nКанал: {{$json.delivery_channel}}\\nTarget: {{$json.auto_delivery_target}}\\nTG: {{$json.telegram_username}}\\n\\n🕐 {{$now}}"
            },
            {
              "name": "client_message",
              "type": "string",
              "value": "Здравствуйте, {{$json.name}}!\\n\\nСпасибо за обращение в Здравницу.\\nМила уже подготовила первый ориентир:\\n{{$json.agent_reply}}\\n\\nЕсли удобно, мы можем организовать звонок со специалистом и подобрать следующий шаг."
            },
            {
              "name": "normalized_channel",
              "type": "string",
              "value": "={{ String($json.delivery_channel || '').toLowerCase().trim() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "Set_Payload",
      "name": "Set Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [500, 340]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "={{$json.manager_message}}",
        "additionalFields": {}
      },
      "id": "Telegram_Manager",
      "name": "Telegram Manager Notify",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [760, 220]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": false,
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.normalized_channel}}",
                    "rightValue": "telegram",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": false,
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.normalized_channel}}",
                    "rightValue": "whatsapp",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": false,
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.normalized_channel}}",
                    "rightValue": "sms",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "Switch_Channel",
      "name": "Switch Delivery Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [760, 460]
    },
    {
      "parameters": {
        "method": "POST",
